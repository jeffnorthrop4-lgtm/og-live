---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends HTMLAttributes<"div"> {
  /** Vertical reach of the aurora curtains. */
  veilHeight?: number;
  /** Brightness of the lower curtain edges. */
  hemStrength?: number;

  /** Aurora drift multiplier. */
  auroraDrift?: number;
  /** Aurora band scale. */
  veilScale?: number;
  /** Overall veil brightness. */
  veilBrightness?: number;
  /** Sets the overall opacity of the shader background wrapper. */
  opacity?: number;
  /** Caps device pixel ratio for sharper output without runaway GPU cost. */
  maxDpr?: number;
  /** Caps the animation frame rate for performance-sensitive pages. */
  maxFps?: 30 | 45 | 60;
  /** Primary veil color as a CSS color or normalized RGB. */
  primaryVeilColor?: string;
  /** Secondary veil color as a CSS color or normalized RGB. */
  secondaryVeilColor?: string;
  /** Glint highlight color as a CSS color or normalized RGB. */
  glintColor?: string;
}

const backgroundStyles = tv({
  base: "bg-background pointer-events-none absolute inset-0 overflow-hidden",
});

const {
  veilHeight = 1,
  hemStrength = 1,
  auroraDrift = 0.4,
  veilScale = 2.2,
  veilBrightness = 0.9,
  opacity = 0.92,
  maxDpr = 1.5,
  maxFps = 60,
  primaryVeilColor = "#14e0b8",
  secondaryVeilColor = "#7857f5",
  glintColor = "#faa147",
  class: className,
  style,
  ...rest
} = Astro.props;

const inlineStyle = [`opacity: var(--shader-opacity, ${opacity})`, style]
  .filter(Boolean)
  .join("; ");
---

<div
  class={backgroundStyles({ class: className })}
  data-shader-aurora-veil
  data-shader-state="loading"
  aria-hidden="true"
  {...rest}
  style={inlineStyle}
>
  <div class="shader-aurora-veil-fallback absolute inset-0"></div>
  <canvas
    class="absolute inset-0 size-full"
    data-shader-aurora-veil-canvas
    data-shader-veil-height={veilHeight}
    data-shader-hem-strength={hemStrength}
    data-shader-aurora-drift={auroraDrift}
    data-shader-glint-color={glintColor}
    data-shader-max-dpr={maxDpr}
    data-shader-max-fps={maxFps}
    data-shader-primary-veil-color={primaryVeilColor}
    data-shader-secondary-veil-color={secondaryVeilColor}
    data-shader-veil-brightness={veilBrightness}
    data-shader-veil-scale={veilScale}></canvas>
</div>

<script>
  import { initShaderAuroraVeilBackgrounds } from "./shaders";

  initShaderAuroraVeilBackgrounds();
  document.addEventListener("astro:after-swap", initShaderAuroraVeilBackgrounds);
</script>

<style>
  .shader-aurora-veil-fallback {
    background-color: var(--background);
    background:
      radial-gradient(
        circle at 22% 72%,
        color-mix(in oklab, var(--primary-accent) 20%, transparent),
        transparent 34%
      ),
      radial-gradient(
        circle at 78% 28%,
        color-mix(in oklab, var(--primary) 20%, transparent),
        transparent 36%
      ),
      linear-gradient(
        145deg,
        var(--background),
        color-mix(in oklab, var(--primary-accent) 9%, var(--background)) 48%,
        var(--background)
      );
  }

  [data-shader-aurora-veil] canvas,
  .shader-aurora-veil-fallback {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  [data-shader-aurora-veil][data-shader-state="running"] canvas {
    opacity: 1;
  }

  [data-shader-aurora-veil][data-shader-state="fallback"] canvas {
    display: none;
  }

  [data-shader-aurora-veil][data-shader-state="fallback"] .shader-aurora-veil-fallback {
    opacity: 1;
  }
</style>

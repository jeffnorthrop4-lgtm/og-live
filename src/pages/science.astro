---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Hero30 from "../components/starwind-pro/hero-30/Hero30.astro";
---

<Base title="Science — OG" description="Science at Oyster Genomics.">
  <div class="relative">
    <nav class="absolute inset-x-0 top-0 z-20 flex w-full items-center justify-between px-6 py-4 md:px-10">
      <a href="/" class="flex h-12 w-12 items-center justify-center bg-fg" aria-label="Oyster Genomics, home">
        <span class="text-base font-semibold tracking-tight text-bg">OG</span>
      </a>
    </nav>
    <Hero30
      heading="Science"
      class="science-hero min-h-svh px-6 md:px-10"
      shaderProps={{ veilHeight: 1.3 }}
    />
  </div>
  <Footer current="science" />
</Base>

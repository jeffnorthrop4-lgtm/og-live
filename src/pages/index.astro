---
import Base from "../layouts/Base.astro";
---

<Base>
  <nav class="flex w-full items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="flex h-12 w-12 items-center justify-center bg-fg" aria-label="Oyster Genomics">
      <span class="text-base font-semibold tracking-tight text-bg">OG</span>
    </a>
  </nav>
  <section class="relative flex h-[calc(100svh-5rem)] items-end px-6 pb-12 md:px-10 md:pb-24">
    <canvas id="hero-canvas" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
    <div class="relative z-10 w-full">
      <h1 class="max-w-5xl text-[clamp(2.4rem,7vw,5.5rem)] font-medium leading-[1] tracking-[-0.05em]">
        The seed company<br />for <span class="text-accent">ocean protein.</span>
      </h1>
    </div>
  </section>
  <footer class="site-footer px-6 md:px-10">
    <a href="mailto:jeff@oystergenomics.com" aria-label="Email Jeff at Oyster Genomics">
      Contact <span aria-hidden="true">↗</span>
    </a>
  </footer>
</Base>

<script>
  import { startHero } from "../scripts/hero-canvas.js";
  startHero();
</script>
